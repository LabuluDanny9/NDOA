NEXT_PUBLIC_APP_URL=http://localhost:3000

# Laissez les deux valeurs vides pour exécuter uniquement l'interface.
# Après `npm run supabase:start`, copiez l'API URL et la publishable key
# affichées par `npm run supabase:status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Ne placez jamais de clé sb_secret_* ou service_role dans NEXT_PUBLIC_*.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Laissez les deux valeurs vides pour exécuter uniquement l'interface.
# Après `npm run supabase:start`, copiez l'API URL et la publishable key
# affichées par `npm run supabase:status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Ne placez jamais de clé sb_secret_* ou service_role dans NEXT_PUBLIC_*.

# Indicateurs non secrets affichés dans l'administration et /api/health.
NDOA_EMAIL_PROVIDER_ENABLED=false
NDOA_SMS_PROVIDER_ENABLED=false
NDOA_WHATSAPP_PROVIDER_ENABLED=false
